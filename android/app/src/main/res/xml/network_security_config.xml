<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- User-configured Search API / seedbox URLs may use LAN HTTP (physical device). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
